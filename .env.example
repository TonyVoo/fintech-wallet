# Copy to `.env` (git-ignored) and change these for anything that is not your own laptop.
# Without a .env file docker-compose falls back to the development defaults below.

# HMAC key (base64, at least 32 bytes) that auth-service signs access tokens with; every service verifies with it.
#   generate one:  openssl rand -base64 48
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LXBsZWFzZS1jaGFuZ2UtaW4tcHJvZC0wMTIzNDU2Nzg5

# Shared key for service-to-service calls to account-service's /internal API.
#   generate one:  openssl rand -hex 32
INTERNAL_API_KEY=dev-internal-key-change-me
